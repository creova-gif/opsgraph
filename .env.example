# OpsGraph Environment Configuration (.env.example)
#
# OpsGraph's deterministic core runs 100% offline with zero environment variables required.
# Copy this file to `.env` ONLY if connecting `opsgraph guardian --propose --consul-url`
# to a live `consul-core` v1 server. Never commit `.env` or Google OAuth JSON files.

# Shared bearer token sent as `Authorization: Bearer <token>` by `HTTPConsulClient`
# when `--consul-url` is provided to `opsgraph guardian --propose`.
# Leave unset for offline deterministic simulation (`StubConsulClient`, simulation=true).
OPSGRAPH_CONSUL_TOKEN=

# Note on Google Drive & Local Store Paths:
# OpsGraph passes file paths explicitly via CLI flags rather than global env vars so
# read-only (`drive.metadata.readonly`) and create-only (`drive.file`) credentials
# never bleed across commands:
#   --db .opsgraph/opsgraph.db
#   --credentials /secure/path/to/client_secret_or_service_account.json
#   --token /secure/path/to/oauth_token_cache.json
#   --state /secure/path/to/drive_changes_state.json
